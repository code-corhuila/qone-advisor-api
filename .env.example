# Names only; values live in qone-infra/.env (never versioned). Everything the service reads.
ADVISOR_DATABASE_URL=postgresql://advisor:password@advisor-db:5432/advisor
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
CURRENT_TERM=2026-B
# Without a key every reply is degraded and still 201 (D-02).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The advisor's own SERVICE token (role SERVICE, sub qone-advisor-api) to start the saga (D-08).
WORKFLOW_URL=http://qone-workflow:8000
SERVICE_TOKEN=
# The consumer process only.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
PORT=8000
LOG_LEVEL=info
